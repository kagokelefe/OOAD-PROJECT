<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.OpenAccountDialogController" spacing="8.0" prefWidth="360.0" prefHeight="220.0">
    <children>
        <Label text="Open Account for User" />
        <VBox spacing="4.0">
            <Label text="Username:" />
            <TextField fx:id="usernameField" />
        </VBox>
        <VBox spacing="4.0">
            <Label text="Account Type:" />
            <ChoiceBox fx:id="typeChoice" />
        </VBox>
        <VBox spacing="4.0">
            <Label text="Initial Deposit:" />
            <TextField fx:id="initialDepositField" />
        </VBox>
        <HBox spacing="10.0">
            <Button fx:id="createButton" text="Create" onAction="#onCreate" />
            <Button text="Cancel" onAction="#onCancel" />
        </HBox>
    </children>
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
</VBox>
