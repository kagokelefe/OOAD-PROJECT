<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AdminDashboardController" spacing="8.0" prefWidth="600.0" prefHeight="400.0">
    <children>
        <Label text="Admin Dashboard" />
        <TableView fx:id="usersTable" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colAcctNo" text="Account" />
                <TableColumn fx:id="colUserId" text="User ID" />
                <TableColumn fx:id="colOwner" text="Owner" />
                <TableColumn fx:id="colEmail" text="Email" />
                <TableColumn fx:id="colType" text="Type" />
                <TableColumn fx:id="colBalance" text="Balance" />
            </columns>
        </TableView>
        <HBox spacing="10.0">
            <Button fx:id="approveButton" text="Approve Selected Account" onAction="#onApprove" />
            <Button fx:id="openAcctButton" text="Open Account for User" onAction="#onOpenAccount" />
            <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" />
            <Button fx:id="logoutButton" text="Logout" onAction="#onLogout" />
        </HBox>
    </children>
</VBox>
